{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(site\\.webmanifest|manifest\\.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/html/(.*)", "destination": "/html/$1" },
    { "source": "/images/(.*)", "destination": "/images/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/site.webmanifest", "destination": "/site.webmanifest" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/404", "destination": "/404.html" },
    { "source": "/404.html", "destination": "/404.html" },
    { "source": "/about", "destination": "/html/about.html" },
    { "source": "/about.html", "destination": "/html/about.html" },
    { "source": "/blog", "destination": "/html/blog.html" },
    { "source": "/blog.html", "destination": "/html/blog.html" },
    { "source": "/contact", "destination": "/html/contact.html" },
    { "source": "/contact.html", "destination": "/html/contact.html" },
    { "source": "/privacy", "destination": "/html/privacy.html" },
    { "source": "/privacy.html", "destination": "/html/privacy.html" },
    { "source": "/terms", "destination": "/html/terms.html" },
    { "source": "/terms.html", "destination": "/html/terms.html" },
    { "source": "/shipping", "destination": "/html/shipping.html" },
    { "source": "/shipping.html", "destination": "/html/shipping.html" },
    { "source": "/refund", "destination": "/html/refund.html" },
    { "source": "/refund.html", "destination": "/html/refund.html" },
    { "source": "/faq", "destination": "/html/faq.html" },
    { "source": "/faq.html", "destination": "/html/faq.html" },
    { "source": "/sitemap", "destination": "/html/sitemap.html" },
    { "source": "/sitemap.html", "destination": "/html/sitemap.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/((?!.*\\.[\\w]+$).*)", "destination": "/index.html" }
  ]
}
